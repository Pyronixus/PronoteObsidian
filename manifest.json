{
  "manifest_version": 3,
  "name": "PRONOTE Obsidian",
  "version": "1.6",
  "description": "Thème sombre moderne et harmonieux pour PRONOTE, avec accent personnalisable.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://pronote.net/*",
    "*://*.pronote.net/*",
    "*://index-education.net/*",
    "*://*.index-education.net/*"
  ],
  "action": {
    "default_title": "PRONOTE Obsidian",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://pronote.net/*",
        "*://*.pronote.net/*",
        "*://index-education.net/*",
        "*://*.index-education.net/*"
      ],
      "css": [
        "theme.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}